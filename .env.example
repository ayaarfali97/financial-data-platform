# Copy to .env and fill in. Never commit the real .env.

# LiteLLM gateway (OpenAI-compatible). Any provider works.
LLM_BASE_URL=http://your-litellm-host:4000
LLM_API_KEY=sk-your-virtual-key
LLM_CHAT_MODEL=gemini/gemini-3-flash
LLM_CHAT_FALLBACK=groq/gpt-oss-120b
LLM_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536
LLM_MAX_TOKENS=1800

# Postgres + pgvector
POSTGRES_USER=fdp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=financial
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_INTERNAL=postgres
POSTGRES_PORT_INTERNAL=5432

# SEC EDGAR requires a User-Agent identifying you (name + email).
SEC_USER_AGENT=your-project your-email@example.com

INGEST_YEARS=5
